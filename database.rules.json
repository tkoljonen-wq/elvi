{
  "rules": {
    ".read": false,
    ".write": false,

    "sessions": {
      ".read": false,
      ".write": false,

      "$code": {
        ".read": true,
        ".write": true,

        "lines": {
          "$lineId": {
            ".validate": "newData.hasChildren(['t'])",
            "t":  { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "ts": { ".validate": "newData.isNumber()" },
            "$muu": { ".validate": false }
          }
        },

        "interim":      { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "speakerOnline": { ".validate": "newData.isBoolean()" },

        "$muu": { ".validate": false }
      }
    }
  }
}
